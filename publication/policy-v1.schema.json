{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doxagon.dev/schemas/publication/policy-v1.schema.json",
  "title": "Doxagon publication policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "items"],
  "properties": {
    "format_version": {"const": 1},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logical_id", "classification", "action"],
        "properties": {
          "logical_id": {"type": "string", "minLength": 1},
          "classification": {"enum": ["public"]},
          "action": {"enum": ["include", "exclude"]}
        }
      }
    }
  }
}
